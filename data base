Database untuk Aplikasi Kasir Mini Market
-- Dibuat untuk integrasi dengan aplikasi Java NetBeans

-- Buat database
CREATE DATABASE IF NOT EXISTS kasir_minimarket;
USE kasir_minimarket;

-- Tabel untuk data barang
CREATE TABLE barang (
    id_barang INT PRIMARY KEY AUTO_INCREMENT,
    nama_barang VARCHAR(50) NOT NULL,
    harga_barang INT NOT NULL,
    stok INT DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

-- Tabel untuk transaksi penjualan
CREATE TABLE transaksi (
    id_transaksi INT PRIMARY KEY AUTO_INCREMENT,
    tanggal_transaksi DATETIME DEFAULT CURRENT_TIMESTAMP,
    total_harga INT NOT NULL,
    jumlah_bayar INT NOT NULL,
    jumlah_kembalian INT NOT NULL,
    status_pembayaran ENUM('Lunas', 'Kurang') DEFAULT 'Lunas'
);

-- Tabel untuk detail transaksi
CREATE TABLE detail_transaksi (
    id_detail INT PRIMARY KEY AUTO_INCREMENT,
    id_transaksi INT NOT NULL,
    id_barang INT NOT NULL,
    nama_barang VARCHAR(50) NOT NULL,
    harga_barang INT NOT NULL,
    jumlah_beli INT NOT NULL,
    subtotal INT NOT NULL,
    FOREIGN KEY (id_transaksi) REFERENCES transaksi(id_transaksi) ON DELETE CASCADE,
    FOREIGN KEY (id_barang) REFERENCES barang(id_barang) ON DELETE RESTRICT
);

-- Tabel untuk user/kasir (opsional, untuk pengembangan selanjutnya)
CREATE TABLE users (
    id_user INT PRIMARY KEY AUTO_INCREMENT,
    username VARCHAR(50) UNIQUE NOT NULL,
    password VARCHAR(255) NOT NULL,
    nama_lengkap VARCHAR(100) NOT NULL,
    role ENUM('Admin', 'Kasir') DEFAULT 'Kasir',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

