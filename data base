-- View untuk laporan penjualan
CREATE VIEW v_laporan_penjualan AS
SELECT 
    t.id_transaksi,
    t.tanggal_transaksi,
    dt.nama_barang,
    dt.harga_barang,
    dt.jumlah_beli,
    dt.subtotal,
    t.total_harga,
    t.jumlah_bayar,
    t.jumlah_kembalian,
    t.status_pembayaran
FROM transaksi t
JOIN detail_transaksi dt ON t.id_transaksi = dt.id_transaksi
ORDER BY t.tanggal_transaksi DESC;

-- View untuk stok barang
CREATE VIEW v_stok_barang AS
SELECT 
    b.id_barang,
    b.nama_barang,
    b.harga_barang,
    b.stok,
    COALESCE(SUM(dt.jumlah_beli), 0) as total_terjual
FROM barang b
LEFT JOIN detail_transaksi dt ON b.id_barang = dt.id_barang
GROUP BY b.id_barang, b.nama_barang, b.harga_barang, b.stok;

